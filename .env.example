# ═══════════════════════════════════════════════
# QuantEdge — variables d'environnement
# ═══════════════════════════════════════════════
# Copie ce fichier en .env puis remplis tes vraies clés.
# JAMAIS committer .env sur git.

# Finnhub — https://finnhub.io/dashboard
FINNHUB_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key (25 req/jour gratuit)
ALPHAVANTAGE_KEY=

# FRED (Federal Reserve of St. Louis) — https://fredaccount.stlouisfed.org/apikeys
FRED_KEY=

# Marketstack — https://marketstack.com/dashboard
MARKETSTACK_KEY=

# SEC EDGAR — pas de clé, mais ils EXIGENT un User-Agent avec ton nom + email.
# Si vide, le fallback est "QuantEdge (contact: user@example.com)".
SEC_USER_AGENT=Carl Koub carlin.koub@gmail.com

# ─── Options héritées ────────────────────────────
# Anthropic API Key (optionnel, pour AI features)
ANTHROPIC_API_KEY=

# Override du microservice Python ML (par défaut 127.0.0.1:8000)
# ML_SERVICE=http://127.0.0.1:8000

# ─── Refinitiv / LSEG Data Platform (RDP) ───────────────────────
# App Key généré sur https://developers.lseg.com/en/api-catalog
RDP_APP_KEY=
# Identifiants de ton compte LSEG Workspace / Eikon
RDP_USERNAME=
RDP_PASSWORD=
